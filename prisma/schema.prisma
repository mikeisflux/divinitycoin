// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER MANAGEMENT
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?

  // Profile
  name          String?

  // Stripe
  stripeCustomerId String? @unique

  // Account status
  bannedAt      DateTime?
  banReason     String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  purchasedCards       GiftCard[]            @relation("PurchasedCards")
  redeemedCards        GiftCard[]            @relation("RedeemedCards")
  creditBalances       CreditBalance[]
  transactions         Transaction[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]

  @@index([email])
  @@index([stripeCustomerId])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // Session metadata
  ipAddress    String?
  userAgent    String?

  @@index([token])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ============================================
// GIFT CARD SYSTEM
// ============================================

model GiftCard {
  id            String         @id @default(cuid())

  // Code (stored as SHA-256 hash)
  codeHash      String         @unique
  codeLast4     String         // Last 4 chars for display

  // Value
  amount        Decimal        @db.Decimal(10, 2)
  initialBalance Int           @default(0) // Initial balance in cents for tracking
  currency      String         @default("USD")

  // Status
  status        GiftCardStatus @default(PENDING)

  // Purchase info
  purchaserId   String?
  purchaser     User?          @relation("PurchasedCards", fields: [purchaserId], references: [id])
  purchasedByEmail String?     // For guest purchases

  // Partner reference
  partnerId     String?
  partner       Partner?       @relation(fields: [partnerId], references: [id])

  // Stripe
  stripePaymentIntentId String? @unique
  stripeCheckoutSessionId String? @unique

  // Redemption info
  redeemedById  String?
  redeemedBy    User?          @relation("RedeemedCards", fields: [redeemedById], references: [id])
  redeemedByEmail String?      // Email of redeemer
  redeemedAt    DateTime?
  redeemedOnPlatform String?   // Which platform redeemed it
  redeemedByPlatformUserId String? // Platform user ID

  // Validity
  activatedAt   DateTime?
  expiresAt     DateTime?

  // Metadata
  metadata      String?        @db.Text

  // Transactions
  transactions  Transaction[]

  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([codeHash])
  @@index([status])
  @@index([purchaserId])
  @@index([partnerId])
  @@index([stripePaymentIntentId])
}

enum GiftCardStatus {
  PENDING    // Created but payment not confirmed
  ACTIVE     // Paid and ready to redeem
  REDEEMED   // Already used
  EXPIRED    // Past expiration date
  REVOKED    // Manually revoked (refund, fraud, etc.)
}

// ============================================
// CREDIT BALANCE SYSTEM
// ============================================

model CreditBalance {
  id              String   @id @default(cuid())

  // User (linked via platform user ID)
  platformUserId  String   @unique  // User ID from IndieCrowdfund
  email           String?  // Email for matching

  // Or local user for account linking
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])

  // Balance
  availableBalance Decimal @db.Decimal(10, 2) @default(0)
  heldBalance      Decimal @db.Decimal(10, 2) @default(0)

  // Timestamps
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  holds           CreditHold[]
  ledgerEntries   CreditLedger[]

  @@index([platformUserId])
  @@index([email])
}

model CreditHold {
  id              String          @id @default(cuid())

  // Balance reference
  creditBalanceId String
  creditBalance   CreditBalance   @relation(fields: [creditBalanceId], references: [id])

  // Hold details
  amount          Decimal         @db.Decimal(10, 2)
  pledgeId        String          @unique  // IndieCrowdfund pledge ID
  projectId       String          // IndieCrowdfund project ID

  // Status
  status          HoldStatus      @default(ACTIVE)

  // Timestamps
  createdAt       DateTime        @default(now())
  expiresAt       DateTime?       // Auto-release if project deadline passes
  capturedAt      DateTime?
  releasedAt      DateTime?

  // Relations
  capture         CreditCapture?

  @@index([pledgeId])
  @@index([creditBalanceId])
  @@index([status])
}

enum HoldStatus {
  ACTIVE     // Credits held for pending pledge
  CAPTURED   // Project funded, credits transferred
  RELEASED   // Project failed or pledge cancelled
  EXPIRED    // Hold expired without action
}

model CreditLedger {
  id              String           @id @default(cuid())

  // Balance reference
  creditBalanceId String
  creditBalance   CreditBalance    @relation(fields: [creditBalanceId], references: [id])

  // Transaction details
  type            LedgerEntryType
  amount          Decimal          @db.Decimal(10, 2) // Positive = credit, Negative = debit

  // Running balance after this entry
  balanceAfter    Decimal          @db.Decimal(10, 2)

  // References
  giftCardId      String?
  holdId          String?
  description     String

  // Metadata
  metadata        Json?

  // Timestamps
  createdAt       DateTime         @default(now())

  @@index([creditBalanceId])
  @@index([type])
  @@index([createdAt])
}

enum LedgerEntryType {
  REDEMPTION       // Gift card redeemed, credits added
  HOLD_PLACED      // Credits held for pledge
  HOLD_RELEASED    // Held credits returned (project failed)
  HOLD_CAPTURED    // Held credits transferred to creator
  ADJUSTMENT       // Manual adjustment
  REFUND           // Refund processed
}

// ============================================
// TRANSACTIONS & AUDIT
// ============================================

model Transaction {
  id              String            @id @default(cuid())

  // User (optional for guest purchases)
  userId          String?
  user            User?             @relation(fields: [userId], references: [id])
  guestEmail      String?

  // Transaction details
  type            TransactionType
  amount          Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  status          TransactionStatus @default(PENDING)

  // Stripe references
  stripePaymentIntentId    String?
  stripeCheckoutSessionId  String?
  stripeRefundId           String?

  // Related gift card
  giftCardId      String?
  giftCard        GiftCard?         @relation(fields: [giftCardId], references: [id])

  // Metadata
  metadata        Json?
  failureReason   String?

  // Timestamps
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  completedAt     DateTime?

  @@index([userId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@index([giftCardId])
}

enum TransactionType {
  PURCHASE    // Gift card purchase
  REFUND      // Refund issued
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// ============================================
// RATE LIMITING & SECURITY
// ============================================

model RedemptionAttempt {
  id          String   @id @default(cuid())

  // Attempt details
  codeHashAttempt String   // Hash of attempted code
  codeLast4       String?  // Last 4 chars for display
  ipAddress       String?
  userAgent       String?
  platformUserId  String?

  // Result
  success         Boolean
  errorCode       String?
  failureReason   String?

  // Timestamps
  createdAt   DateTime @default(now())

  @@index([ipAddress, createdAt])
  @@index([platformUserId, createdAt])
  @@index([codeHashAttempt])
}

// ============================================
// SYSTEM CONFIGURATION
// ============================================

model SystemConfig {
  key         String   @id
  value       String   @db.Text
  isEncrypted Boolean  @default(false)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================
// ADMIN SYSTEM
// ============================================

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String

  // Profile
  name          String

  // Role & Permissions
  role          AdminRole @default(ADMIN)
  permissions   Json?     // Granular permissions override

  // Security
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  failedLoginAttempts Int @default(0)
  lockedUntil   DateTime?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  sessions      AdminSession[]
  auditLogs     AdminAuditLog[]

  @@index([email])
}

enum AdminRole {
  SUPER_ADMIN   // Full access to everything
  ADMIN         // Full access except admin management
  FINANCE       // Transactions, payments, reports only
  SUPPORT       // Users, gift cards, transactions (read-only finance)
  VIEWER        // Read-only access to everything
}

model AdminSession {
  id          String    @id @default(cuid())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  token       String    @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  lastActivityAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([adminId])
}

model AdminAuditLog {
  id          String    @id @default(cuid())
  adminId     String
  admin       AdminUser @relation(fields: [adminId], references: [id])

  action      String    // e.g., "settings.update", "giftcard.revoke"
  resource    String    // e.g., "GiftCard", "Partner"
  resourceId  String?

  details     String?   @db.Text  // JSON string of details

  ipAddress   String?
  userAgent   String?

  createdAt   DateTime  @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// PARTNER SYSTEM
// ============================================

model Partner {
  id            String        @id @default(cuid())

  // Identity
  name          String        // "IndieCrowdfund"
  slug          String        @unique // "indiecrowdfund"

  // Contact
  contactName   String?
  contactEmail  String?
  website       String?

  // Configuration
  status        PartnerStatus @default(PENDING)
  vpnIp         String?       // Partner's VPN IP (e.g., 10.10.0.2)
  webhookUrl    String?       // Partner's webhook endpoint
  webhookSecret String?       // HMAC secret for webhook signatures
  webhookEvents String[]      @default([]) // Subscribed event types

  // Settlement Configuration
  settlementFrequency SettlementFrequency @default(WEEKLY)
  minimumSettlement   Decimal             @db.Decimal(10, 2) @default(100)
  partnerFeePercent   Decimal             @db.Decimal(5, 4) @default(0.06) // 6% default
  paymentMethod       String?             // wire, ach, paypal, etc.
  bankName            String?
  bankAccountLast4    String?
  bankAccountEncrypted String?   @db.Text  // AES-256-GCM encrypted account number
  bankRoutingEncrypted String?   @db.Text  // AES-256-GCM encrypted routing number
  paypalEmail         String?

  // Onboarding
  onboardingStep      Int       @default(0)  // 0=not started, 1=password, 2=company, 3=banking, 4=complete
  onboardingComplete  Boolean   @default(false)

  // Branding
  logoUrl       String?
  description   String?

  // Settings
  settings      Json?         // Partner-specific settings

  // Timestamps
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activatedAt   DateTime?

  // Relations
  apiKeys       PartnerApiKey[]
  giftCards     GiftCard[]
  settlements   PartnerSettlement[]
  captures      CreditCapture[]

  @@index([slug])
  @@index([status])
}

enum SettlementFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PartnerStatus {
  PENDING       // Awaiting setup
  ACTIVE        // Live and operational
  SUSPENDED     // Temporarily disabled
  DEACTIVATED   // Permanently disabled
}

model PartnerApiKey {
  id           String    @id @default(cuid())
  partnerId    String
  partner      Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  name         String    // "Production", "Staging"
  keyHash      String    @unique // SHA-256 hash of the key
  keyPrefix    String    // First 10 chars for identification
  encryptedKey String?   @db.Text // Encrypted version of the key

  // Permissions
  permissions  Json?     // Specific endpoint permissions

  // Usage
  lastUsedAt   DateTime?
  requestCount BigInt    @default(0)

  // Status
  isActive     Boolean   @default(true)
  expiresAt    DateTime?

  // Timestamps
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?

  @@index([keyHash])
  @@index([partnerId])
}

// ============================================
// API REQUEST LOGGING
// ============================================

model ApiRequestLog {
  id            String    @id @default(cuid())

  // Partner reference
  partnerId     String?
  apiKeyId      String?

  // Request details
  method        String    // GET, POST, etc.
  endpoint      String    // /api/v1/cards
  path          String    // Full path with params

  // Client info
  ipAddress     String
  userAgent     String?

  // Response
  statusCode    Int
  responseTimeMs Int

  // Optional data
  requestBody   String?   @db.Text
  responseBody  String?   @db.Text
  errorMessage  String?

  // Timestamp
  timestamp     DateTime  @default(now())

  @@index([partnerId])
  @@index([apiKeyId])
  @@index([timestamp])
  @@index([endpoint])
  @@index([statusCode])
}

// ============================================
// EMAIL SYSTEM
// ============================================

model EmailLog {
  id            String      @id @default(cuid())

  // Recipient
  toEmail       String
  toName        String?

  // Sender
  fromEmail     String
  fromName      String

  // Content
  templateId    String?
  template      EmailTemplate? @relation(fields: [templateId], references: [id])
  subject       String
  htmlContent   String?     @db.Text
  textContent   String?     @db.Text

  // SendGrid
  sendgridMessageId String? @unique

  // Status
  status        EmailStatus @default(QUEUED)
  statusMessage String?

  // Tracking
  deliveredAt   DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  bouncedAt     DateTime?

  // Relations
  userId        String?
  transactionId String?
  giftCardId    String?

  // Timestamps
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  // Events from SendGrid webhooks
  events        EmailEvent[]

  @@index([toEmail])
  @@index([status])
  @@index([templateId])
  @@index([sendgridMessageId])
}

enum EmailStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
  SPAM
}

model EmailEvent {
  id          String    @id @default(cuid())
  emailLogId  String
  emailLog    EmailLog  @relation(fields: [emailLogId], references: [id], onDelete: Cascade)

  event       String    // delivered, open, click, bounce, etc.
  timestamp   DateTime
  data        Json?     // Raw event data from SendGrid

  @@index([emailLogId])
}

model EmailTemplate {
  id          String    @id @default(cuid())

  // Identity
  name        String    // Internal name
  slug        String    @unique // purchase_confirmation, etc.
  description String?

  // Content
  subject     String
  htmlContent String    @db.Text
  textContent String?   @db.Text

  // Settings
  isActive    Boolean   @default(true)
  accountId   String?   // Which email account to use

  // Versioning
  version     Int       @default(1)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  emailLogs   EmailLog[]
  versions    EmailTemplateVersion[]
}

model EmailTemplateVersion {
  id          String        @id @default(cuid())
  templateId  String
  template    EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version     Int
  subject     String
  htmlContent String        @db.Text
  textContent String?       @db.Text

  // Who made the change
  changedBy   String?
  changeNote  String?

  createdAt   DateTime      @default(now())

  @@unique([templateId, version])
}

// ============================================
// SETTLEMENT SYSTEM
// ============================================

model PartnerSettlement {
  id            String            @id @default(cuid())

  // Partner reference
  partnerId     String
  partner       Partner           @relation(fields: [partnerId], references: [id])

  // Period
  periodStart   DateTime
  periodEnd     DateTime

  // Amounts
  grossAmount   Decimal           @db.Decimal(12, 2)  // Total captured amount
  partnerFee    Decimal           @db.Decimal(12, 2)  // Platform fee (6%)
  feePercentage Decimal           @db.Decimal(5, 4)   // Fee percentage used
  netAmount     Decimal           @db.Decimal(12, 2)  // Amount to pay partner
  currency      String            @default("USD")

  // Status
  status        SettlementStatus  @default(PENDING)

  // Payment details
  paymentMethod String?           // wire, ach, paypal
  paymentRef    String?           // Wire reference, PayPal transaction ID, etc.
  paidAt        DateTime?

  // Admin notes
  adminNotes    String?           @db.Text
  disputeReason String?           @db.Text

  // Approval tracking
  approvedBy    String?           // Admin user ID
  approvedAt    DateTime?

  // Timestamps
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  captures      CreditCapture[]

  @@index([partnerId])
  @@index([status])
  @@index([periodEnd])
  @@index([createdAt])
}

enum SettlementStatus {
  PENDING     // Awaiting approval
  APPROVED    // Approved, ready for payment
  PROCESSING  // Payment initiated
  PAID        // Payment confirmed
  FAILED      // Payment failed
  DISPUTED    // Under dispute
}

model CreditCapture {
  id            String            @id @default(cuid())

  // Partner reference
  partnerId     String
  partner       Partner           @relation(fields: [partnerId], references: [id])

  // Hold reference
  holdId        String            @unique
  hold          CreditHold        @relation(fields: [holdId], references: [id])

  // Creator info (from partner)
  creatorId     String            // Partner's creator ID
  creatorEmail  String?
  projectId     String            // Partner's project ID
  projectName   String?

  // Amount
  amount        Decimal           @db.Decimal(10, 2)

  // Settlement reference (null until settled)
  settlementId  String?
  settlement    PartnerSettlement? @relation(fields: [settlementId], references: [id])

  // Timestamps
  capturedAt    DateTime          @default(now())

  @@index([partnerId])
  @@index([settlementId])
  @@index([creatorId])
  @@index([projectId])
  @@index([capturedAt])
}

// ============================================
// EMAIL INBOX SYSTEM
// ============================================

model Mailbox {
  id            String    @id @default(cuid())

  // Email address
  email         String    @unique  // support@divinitycoin.com
  name          String              // "Support", "Sales", etc.

  // Settings
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)

  // Auto-reply settings
  autoReplyEnabled  Boolean @default(false)
  autoReplySubject  String?
  autoReplyMessage  String? @db.Text

  // Signature
  signature     String?   @db.Text

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  emails        Email[]

  @@index([email])
  @@index([isActive])
}

model Email {
  id            String      @id @default(cuid())

  // Mailbox reference
  mailboxId     String
  mailbox       Mailbox     @relation(fields: [mailboxId], references: [id], onDelete: Cascade)

  // Direction
  direction     EmailDirection @default(INBOUND)

  // Sender
  fromEmail     String
  fromName      String?

  // Recipients
  toEmail       String
  toName        String?
  ccEmails      String[]    @default([])
  bccEmails     String[]    @default([])

  // Content
  subject       String
  textBody      String?     @db.Text
  htmlBody      String?     @db.Text

  // Threading
  threadId      String?     // Group related emails
  inReplyTo     String?     // Message-ID of parent email
  messageId     String?     @unique  // Unique message ID

  // Status
  isRead        Boolean     @default(false)
  isStarred     Boolean     @default(false)
  isArchived    Boolean     @default(false)
  isDeleted     Boolean     @default(false)
  isSpam        Boolean     @default(false)
  isDraft       Boolean     @default(false)

  // Labels/folders
  labels        String[]    @default([])
  folder        EmailFolder @default(INBOX)

  // SendGrid tracking
  sendgridMessageId String?

  // Spam info
  spamScore     Float?
  senderIp      String?

  // Attachments
  hasAttachments Boolean    @default(false)

  // Timestamps
  receivedAt    DateTime    @default(now())
  sentAt        DateTime?
  readAt        DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  attachments   EmailAttachment[]

  @@index([mailboxId])
  @@index([direction])
  @@index([folder])
  @@index([isRead])
  @@index([isDeleted])
  @@index([threadId])
  @@index([receivedAt])
  @@index([fromEmail])
}

enum EmailDirection {
  INBOUND
  OUTBOUND
}

enum EmailFolder {
  INBOX
  SENT
  DRAFTS
  TRASH
  SPAM
  ARCHIVE
}

model EmailAttachment {
  id            String    @id @default(cuid())
  emailId       String
  email         Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  filename      String
  contentType   String
  size          Int       // Size in bytes

  // Storage
  storageKey    String?   // S3/storage key
  url           String?   // Direct URL if available

  createdAt     DateTime  @default(now())

  @@index([emailId])
}

// ============================================
// REFUND REQUESTS
// ============================================

model RefundRequest {
  id                String              @id @default(cuid())

  // Request info
  transactionId     String
  giftCardId        String?
  userId            String?
  email             String
  amount            Decimal             @db.Decimal(10, 2)
  reason            String?             @db.Text

  // Status
  status            RefundRequestStatus @default(PENDING)

  // Partner webhook (if code was redeemed)
  partnerId         String?
  partnerName       String?
  webhookSent       Boolean             @default(false)
  webhookSentAt     DateTime?
  webhookResponse   Json?
  partnerRefundId   String?             // ID returned by partner

  // Original redemption info (for partner webhook)
  originalCardCode  String?             // Last 4 chars only
  redeemedAmount    Decimal?            @db.Decimal(10, 2)

  // Stripe refund
  stripeRefundId    String?

  // Timestamps
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?             @db.Text

  @@index([transactionId])
  @@index([giftCardId])
  @@index([userId])
  @@index([status])
  @@index([partnerId])
  @@index([createdAt])
}

enum RefundRequestStatus {
  PENDING           // Awaiting processing
  AWAITING_PARTNER  // Webhook sent to partner, awaiting response
  APPROVED          // Approved, ready for Stripe refund
  PROCESSING        // Stripe refund in progress
  COMPLETED         // Refund completed
  FAILED            // Refund failed (partner rejected or Stripe error)
  REJECTED          // Admin rejected
}

// ============================================
// EMAIL QUEUE SYSTEM
// ============================================

model EmailQueue {
  id            String           @id @default(cuid())

  // Recipient
  toEmail       String
  toName        String?

  // Sender (override defaults if provided)
  fromEmail     String?
  fromName      String?

  // Content
  subject       String
  htmlBody      String           @db.Text
  textBody      String?          @db.Text

  // Mailbox reference (optional, for inbox tracking)
  mailboxId     String?

  // Status
  status        EmailQueueStatus @default(PENDING)

  // Priority (lower = higher priority)
  priority      Int              @default(10)

  // Retry tracking
  attempts      Int              @default(0)
  maxAttempts   Int              @default(3)
  lastError     String?          @db.Text
  nextRetryAt   DateTime?

  // Bulk send tracking
  bulkSendId    String?          // Group emails from same bulk send
  bulkSendIndex Int?             // Position in bulk send

  // Result
  sendgridMessageId String?
  sentAt        DateTime?

  // Timestamps
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  scheduledAt   DateTime?        // Schedule for future sending
  processedAt   DateTime?

  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([bulkSendId])
  @@index([createdAt])
}

enum EmailQueueStatus {
  PENDING       // Waiting to be sent
  PROCESSING    // Currently being sent
  SENT          // Successfully sent
  FAILED        // All retries exhausted
  CANCELLED     // Manually cancelled
}

// ============================================
// PARTNER PAYMENT SYSTEM (Seamless Payments)
// ============================================

model PlatformUser {
  id                String    @id @default(cuid())

  // Partner reference
  partnerId         String

  // Platform identity
  platformUserId    String    @unique  // User ID from partner platform
  email             String

  // Stripe customer on DC's account
  stripeCustomerId  String?   @unique

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  pendingPayments   PendingPartnerPayment[]

  @@index([partnerId])
  @@index([platformUserId])
  @@index([email])
}

model PendingPartnerPayment {
  id                String    @id @default(cuid())

  // Stripe payment intent
  paymentIntentId   String    @unique

  // Partner reference
  partnerId         String

  // Platform user reference
  platformUserId    String
  platformUser      PlatformUser? @relation(fields: [platformUserId], references: [platformUserId])

  // Pledge/project reference (from partner)
  pledgeId          String
  projectId         String

  // Payment details
  amount            Int       // Amount in cents
  currency          String    @default("usd")
  email             String

  // Status tracking
  status            PartnerPaymentStatus @default(PENDING)

  // Gift card created after payment succeeds
  giftCardId        String?

  // Hold created after auto-redemption
  holdId            String?

  // Refund info
  refundId          String?
  refundedAt        DateTime?

  // Webhook delivery tracking
  webhookSent       Boolean   @default(false)
  webhookSentAt     DateTime?

  // Timestamps
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([partnerId])
  @@index([platformUserId])
  @@index([pledgeId])
  @@index([status])
}

enum PartnerPaymentStatus {
  PENDING       // PaymentIntent created, awaiting payment
  PROCESSING    // Payment in progress
  COMPLETED     // Payment succeeded, gift card created, redeemed, held
  FAILED        // Payment failed
  REFUNDED      // Payment refunded
}

// Firewall-level IP blocks. Paired with the botblock-firewall watcher in
// scripts/botblock/ which picks up /tmp/botblock-pending and applies iptables
// DROP rules. `expiresAt` lets the sync script age rules out.
model BlockedIP {
  id              String   @id @default(cuid())
  ipAddress       String   @unique
  reason          String
  violationCount  Int      @default(1)
  blockedAt       DateTime @default(now())
  expiresAt       DateTime

  lastUserAgent   String?
  lastPath        String?
  lastActionId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ipAddress])
  @@index([expiresAt])
}

// Audit trail of suspicious requests, whether or not they triggered a block.
model SuspiciousActivity {
  id         String   @id @default(cuid())
  ipAddress  String
  reason     String
  actionId   String?
  path       String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([ipAddress])
  @@index([createdAt])
}
