# Database
DATABASE_URL="postgresql://user:password@localhost:5432/divinitycoin"

# Application
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"

# Internal API (generate with: openssl rand -base64 32)
# SECURITY: Generate a unique secret, do NOT use this placeholder
INTERNAL_API_KEY="CHANGE_ME_generate_with_openssl_rand_base64_32"

# SendGrid (get from https://app.sendgrid.com/settings/api_keys)
SENDGRID_API_KEY="SG.your_sendgrid_api_key_here"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="YourAppName"
SENDGRID_WEBHOOK_SECRET="your-webhook-secret-here"

# Admin (generate with: openssl rand -base64 32)
# SECURITY: Generate unique secrets, do NOT use these placeholders
ADMIN_SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"
ADMIN_INITIAL_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="CHANGE_ME_use_a_strong_unique_password"

# Encryption (generate with: openssl rand -base64 32)
# SECURITY: Generate a unique secret, do NOT use this placeholder
ENCRYPTION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# CSRF/Auth Secret (generate with: openssl rand -base64 32)
# SECURITY: Required for CSRF protection - application will fail without this
CSRF_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_ATTEMPTS="5"
