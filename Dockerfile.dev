# Dockerfile.dev
# Development dockerfile with hot reloading

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy prisma schema for generation
COPY prisma ./prisma/

# Generate Prisma client
RUN npx prisma generate

# Copy remaining source
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
